---
import { Image } from 'astro:assets'
import dashboard from '@/assets/product/dashboard.png'
import DownloadButton from '@/components/download/DownloadButton.astro'
import { REPOSITORY_URL } from '@/config/site'
import releaseManifest from '@/data/release-manifest.json'
import type { ReleaseManifest } from '@/lib/releases/types'

const stable = (releaseManifest as ReleaseManifest).channels.stable
---

<section class="hero container">
  <div class="hero-copy">
    <p class="eyebrow">Open source · Local first · Apache-2.0</p>
    <h1>Your local development command center.</h1>
    <p class="lede">Start Docker Compose services and local processes, read their logs, and find port conflicts from one dashboard. Keep using your existing repositories and commands.</p>
    <div class="hero-actions">
      <DownloadButton />
      <a class="button" href={REPOSITORY_URL}>View on GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <p class="release-note"><span class:list={{ available: Boolean(stable) }}></span> {stable ? `${stable.tag} stable` : 'No stable binaries yet · build from source on macOS or Linux'}</p>
    <p class="platform-note"><a href="/download/windows/">Windows</a> and <a href="/download/wsl/">WSL2</a>: coming soon.</p>
  </div>
  <figure class="product-frame">
    <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>Envarium · Dashboard</span></div>
    <Image
      src={dashboard}
      alt="Envarium dashboard showing running, stopped, and Docker-unavailable projects with Git, endpoint, and resource status."
      widths={[640, 768, 960, 1280, 1440]}
      sizes="(max-width: 1040px) calc(100vw - 2rem), (max-width: 1212px) 52vw, 620px"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption>Product screenshot with example projects.</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - 4.7rem);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  h1 {
    max-width: 16ch;
    margin: 0.65rem 0 1.2rem;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    letter-spacing: -0.065em;
    line-height: 1.03;
    overflow-wrap: anywhere;
  }

  .lede {
    max-width: 43rem;
    color: var(--sy-text-muted);
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .release-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.15rem 0;
    color: var(--sy-text-soft);
    font-family: var(--sy-font-mono);
    font-size: 0.76rem;
  }

  .release-note span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--sy-status-warning);
  }

  .release-note span.available {
    background: var(--sy-status-success);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--sy-status-success) 65%, transparent);
  }

  .platform-note { color: var(--sy-text-muted); font-size: 0.85rem; }
  .platform-note a { color: var(--sy-accent-primary); }

  .product-frame {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--sy-border-subtle);
    border-radius: 1.2rem;
    background: var(--brand-canvas);
    box-shadow: var(--sy-shadow);
  }

  .product-frame :global(img) {
    width: 100%;
    height: auto;
  }

  .frame-bar {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    gap: 0.35rem;
    border-bottom: 1px solid var(--sy-border-subtle);
    background: var(--sy-bg-surface);
    padding-inline: 0.8rem;
  }

  .frame-bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--sy-text-soft);
  }

  .frame-bar i:first-child { background: var(--sy-status-danger); }
  .frame-bar i:nth-child(2) { background: var(--sy-status-warning); }
  .frame-bar i:nth-child(3) { background: var(--sy-status-success); }

  .frame-bar span {
    margin-left: 0.5rem;
    color: var(--sy-text-soft);
    font-family: var(--sy-font-mono);
    font-size: 0.67rem;
  }

  figcaption {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 1040px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      max-width: 11ch;
    }

    .product-frame {
      transform: none;
    }
  }

  @media (max-width: 580px) {
    .hero {
      min-height: auto;
      padding-block: 3.5rem 2rem;
    }

    h1 {
      font-size: clamp(2.5rem, 13vw, 4.5rem);
    }
  }
</style>

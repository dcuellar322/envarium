---
import { REPOSITORY_URL } from '@/config/site'

const proof = [
  ['Apache-2.0', 'Use, modify, and distribute under Apache-2.0'],
  ['Public source', 'Read the code and build it yourself'],
  ['Release verification', 'How to check packages before running them'],
  ['Contributions welcome', 'Bug reports, documentation, and focused code changes'],
]
---

<section class="open-source" aria-labelledby="open-source-title">
  <div class="container open-grid">
    <div>
      <p class="eyebrow">Apache-2.0 licensed</p>
      <h2 id="open-source-title">Read the code. Help improve it.</h2>
      <p class="intro">The source, build instructions, and architecture decisions are in the repository. Report a bug, improve a guide, or pick an issue. No account is required to run Envarium.</p>
      <div class="actions">
        <a class="button primary" href={REPOSITORY_URL}>View source <span aria-hidden="true">↗</span></a>
        <a class="button" href="/contributing/">Contribute</a>
      </div>
    </div>
    <div class="proof-grid">
      {proof.map(([title, description]) => (
        <article class="panel"><span aria-hidden="true">✓</span><h3>{title}</h3><p>{description}</p></article>
      ))}
    </div>
  </div>
</section>

<style>
  .open-source {
    border-block: 1px solid var(--sy-border-subtle);
    background: var(--sy-bg-surface);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .open-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  h2 {
    max-width: 20ch;
    margin: 0.5rem 0 1.2rem;
    font-size: clamp(2rem, 3.3vw, 3.1rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .intro {
    color: var(--sy-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  article {
    min-height: 12rem;
    padding: 1.25rem;
  }

  article span {
    color: var(--sy-status-success);
    font-family: var(--sy-font-mono);
  }

  h3 { margin: 1.25rem 0 0.4rem; }
  article p { margin: 0; color: var(--sy-text-muted); font-size: 0.87rem; }

  @media (max-width: 850px) {
    .open-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .proof-grid { grid-template-columns: 1fr; }
  }
</style>

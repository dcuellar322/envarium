---
import { integrations, type Integration } from '@/content/marketing/integrations'
import ContentPageLayout from '@/layouts/ContentPageLayout.astro'

export function getStaticPaths() {
  return integrations.map((integration) => ({ params: { slug: integration.slug }, props: { integration } }))
}

interface Props { integration: Integration }
const { integration } = Astro.props as Props
const agentIntegration = integration.slug === 'codex' || integration.slug === 'claude-code' || integration.slug === 'mcp'
const installCommand = integration.slug === 'codex' ? 'envarium agent install codex --profile observe' : integration.slug === 'claude-code' ? 'envarium agent install claude --profile observe' : integration.slug === 'mcp' ? 'envarium mcp serve --transport stdio --profile observe' : undefined
const installedFiles = integration.slug === 'codex'
  ? ['.codex/config.toml', '.agents/skills/envarium-operate/SKILL.md', 'AGENTS.md']
  : integration.slug === 'claude-code'
    ? ['.mcp.json', '.claude/skills/envarium-operate/SKILL.md', 'AGENTS.md', 'CLAUDE.md']
    : []
const clientConfig = JSON.stringify({ type: 'stdio', command: '/absolute/path/to/envarium', args: ['mcp', 'serve', '--transport', 'stdio', '--profile', 'observe'] }, null, 2)
---

<ContentPageLayout title={`${integration.name} integration`} eyebrow="Integration" description={integration.description}>
  <p class="prerequisite">First, <a href="/download/">install or build Envarium</a> on macOS or Linux. Windows and WSL2 support is coming soon.</p>
  <section class="setup-grid"><div><p class="eyebrow">Setup</p><h2>Set up the integration.</h2></div><ol>{integration.setup.map((step) => <li>{step}</li>)}</ol></section>
  {installCommand && <section class="command panel"><div><h2>Start with read-only access.</h2><p>{integration.slug === 'mcp' ? 'Let your MCP client launch this server over stdio. Replace the example binary path below; the exact configuration wrapper depends on your client.' : 'Run this from the repository root. The default installation writes project-local configuration and guidance; review the changed files before using them.'}</p></div><pre tabindex="0" data-mcp-config={integration.slug === 'mcp' ? '' : undefined}><code>{integration.slug === 'mcp' ? clientConfig : installCommand}</code></pre></section>}
  {agentIntegration && <div class="agent-grid">
    <article class="panel"><h2>Limit project access</h2><p>Add <code>--project PROJECT_ID</code> to the server arguments or installer command for each project the client may access. Without this allowlist, it can access all registered projects permitted by its profile. Project-local configuration alone does not restrict project access.</p><p>Use <code>envarium project list</code> to find project IDs. For a custom data directory, pass <code>--data-dir /absolute/path/to/data</code> before <code>agent install</code> or <code>mcp serve</code> so the CLI and client use the same projects.</p></article>
    <article class="panel"><h2>Permission profiles</h2><p><strong>observe</strong> allows reads. <strong>develop</strong> adds service operations and approved actions, excluding destructive actions. <strong>maintain</strong> adds deploy, rebuild, and configuration proposals. <strong>admin</strong> adds destructive operations and approval of discovered configuration. AI-generated revisions still require human approval.</p></article>
    <article class="panel"><h2>Check the result</h2><p>Read project status before changing services. Give each change its own request ID, wait for the operation result, then check health and logs. Reuse a request ID only when retrying the same request.</p></article>
    <article class="panel"><h2>Authorization failures</h2><p>Check the server’s permission profile, project allowlist, and the client’s loaded tool list. Requests outside that scope are denied. After changing configuration, reload the client connection. Prompt text cannot grant permissions.</p></article>
    {installedFiles.length > 0 && <article class="panel"><h2>Files changed by the installer</h2><p>The default project installation writes or updates:</p><ul>{installedFiles.map((file) => <li><code>{file}</code></li>)}</ul><p>Review the diff and preserve any existing configuration. With <code>--scope user</code>, the MCP entry goes in <code>{integration.slug === 'codex' ? '~/.codex/config.toml' : '~/.claude.json'}</code> and the skill goes in your home directory. Project guidance is not added in that mode.</p></article>}
    <article class="panel"><h2>Remove the integration</h2><p>{installedFiles.length > 0 ? 'Remove the Envarium MCP entry, its envarium-operate skill, and the marked Envarium guidance block. Keep unrelated configuration and guidance.' : 'Remove the Envarium server entry from your MCP client’s configuration and reload the client.'} Envarium projects and local data are retained.</p>{integration.slug === 'claude-code' && <p>Remove the <code>@AGENTS.md</code> import in <code>CLAUDE.md</code> only if you no longer use it.</p>}</article>
  </div>}
  <section class="docs-link panel"><div><p class="eyebrow">Documentation</p><h2>Commands and configuration</h2></div><a class="button" href={integration.docsHref}>Open reference</a></section>
</ContentPageLayout>

<style>
  .setup-grid { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 3rem; }
  .prerequisite { margin: 0 0 2rem; color: var(--sy-text-muted); }
  .prerequisite a { color: var(--sy-accent-primary); }
  article code { overflow-wrap: anywhere; }
  h2 { margin: 0.35rem 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1; }
  ol { display: grid; gap: 1rem; margin: 0; padding-left: 1.4rem; color: var(--sy-text-muted); }
  li { border-bottom: 1px solid var(--sy-border-subtle); padding: 0 0 0.8rem 0.4rem; }
  .command { display: grid; grid-template-columns: 0.8fr 1.2fr; align-items: center; gap: 2rem; margin-top: 3rem; padding: 1.5rem; }
  .command h2 { font-size: 1.4rem; }
  .command p, article p { color: var(--sy-text-muted); font-size: 0.88rem; }
  pre { overflow-x: auto; margin: 0; border-radius: 0.65rem; background: var(--brand-canvas); color: var(--brand-green); padding: 1rem; }
  .agent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
  article { padding: 1.3rem; }
  article h2 { font-size: 1.08rem; }
  .docs-link { display: flex; align-items: center; gap: 2rem; margin-top: 2rem; padding: 1.4rem; }
  .docs-link h2 { font-size: 1.25rem; }
  .docs-link a { margin-left: auto; }
  @media (max-width: 700px) { .setup-grid, .command, .agent-grid { grid-template-columns: 1fr; } .docs-link { align-items: stretch; flex-direction: column; } .docs-link a { margin-left: 0; } }
</style>

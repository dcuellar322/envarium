---
import ReleaseDownloadCard from '@/components/download/ReleaseDownloadCard.astro'
import { platformGuides, type PlatformGuide } from '@/content/download/platforms'
import releaseManifest from '@/data/release-manifest.json'
import ContentPageLayout from '@/layouts/ContentPageLayout.astro'
import { recommendAsset } from '@/lib/releases/recommend'
import type { ReleaseManifest } from '@/lib/releases/types'

export function getStaticPaths() {
  return platformGuides.map((guide) => ({ params: { platform: guide.slug }, props: { guide } }))
}

interface Props { guide: PlatformGuide }
const { guide } = Astro.props as Props
const manifest = releaseManifest as ReleaseManifest
const release = manifest.channels.stable
const primaryArchitecture = guide.architectures[0] ?? 'amd64'
const asset = guide.comingSoon ? undefined : recommendAsset(release, guide.releasePlatform, primaryArchitecture)
const desktopPackage = asset && ['dmg', 'app', 'appimage', 'deb', 'rpm'].includes(asset.packageType)
const alternatives = !guide.comingSoon && release?.assets.filter((candidate) => {
  const platform = guide.releasePlatform === 'wsl' ? 'linux' : guide.releasePlatform
  return candidate.platform === platform && candidate.name !== asset?.name
}) || []
---

<ContentPageLayout title={guide.comingSoon ? `${guide.shortName} is coming soon` : `Install Envarium on ${guide.shortName}`} eyebrow={guide.comingSoon ? 'Platform status' : 'Platform install'} description={guide.comingSoon ? `Public ${guide.shortName} support and packages are not available yet. The requirements below are targets for upcoming support.` : `${guide.requirements} Check package availability below, or build from source.`}>
  <div class="platform-layout">
    <div>
      {guide.comingSoon ? <article class="panel coming-soon"><h2>{guide.shortName} support is coming soon.</h2><p>Public packages are not available yet. Follow the roadmap or help test platform support.</p><a class="button" href="/roadmap/">View roadmap</a><a class="button quiet" href="/contributing/">Contribute</a></article> : <ReleaseDownloadCard release={release} asset={asset} label={`${guide.shortName} · ${primaryArchitecture}`} />}
      {alternatives.length > 0 && <section class="alternatives panel"><h2>Alternative packages</h2><ul>{alternatives.map((alternative) => <li><a href={alternative.downloadUrl}>{alternative.name}</a><span>{alternative.architecture} · {alternative.packageType}</span></li>)}</ul></section>}
    </div>
    <aside class="panel"><p class="eyebrow">{guide.comingSoon ? 'Target requirements' : desktopPackage ? 'Install path' : 'Build from source'}</p>{guide.comingSoon ? <p>{guide.requirements}</p> : desktopPackage ? <ol>{guide.install.map((step) => <li>{step}</li>)}</ol> : <><p>No stable desktop installer is available for this selection. Build the CLI and browser UI, or build the desktop app with Rust and the platform dependencies.</p><p><a href="/download/cli/#build-from-source">CLI build instructions →</a></p><p><a href="/docs/desktop-installation/#build-from-source">Desktop build instructions →</a></p></>}<h2>Verify release packages</h2><p>{guide.verify}</p><a href="/download/verify/">Open verification guide →</a></aside>
  </div>
  {!guide.comingSoon && <section class="after-install panel"><div><p class="eyebrow">After installation</p><h2>Check your installation.</h2><p>After installation, <code>envarium doctor</code> reports platform capabilities and <code>envarium ui</code> opens the local browser UI. Envarium does not require an account.</p></div><pre tabindex="0"><code>envarium doctor
envarium ui</code></pre></section>}
</ContentPageLayout>

<style>
  .platform-layout { display: grid; grid-template-columns: 1.3fr 0.7fr; align-items: start; gap: 1rem; }
  .coming-soon { padding: 1.5rem; }
  .coming-soon p { color: var(--sy-text-muted); }
  aside { padding: 1.4rem; }
  aside ol { display: grid; gap: 1rem; padding-left: 1.2rem; color: var(--sy-text-muted); }
  aside h2 { margin-top: 2rem; font-size: 1.1rem; }
  aside p:not(.eyebrow) { color: var(--sy-text-muted); font-size: 0.88rem; }
  aside a { color: var(--sy-accent-primary); font-weight: 750; text-decoration: none; }
  .alternatives { margin-top: 1rem; padding: 1.4rem; }
  .alternatives h2 { margin-top: 0; font-size: 1.15rem; }
  .alternatives ul { display: grid; gap: 0.5rem; padding: 0; list-style: none; }
  .alternatives li { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--sy-border-subtle); padding-top: 0.6rem; }
  .alternatives a { overflow-wrap: anywhere; color: var(--sy-accent-primary); }
  .alternatives span { flex: 0 0 auto; color: var(--sy-text-soft); font-family: var(--sy-font-mono); font-size: 0.72rem; }
  .after-install { display: grid; grid-template-columns: 1fr 0.8fr; align-items: center; gap: 2rem; margin-top: 3rem; padding: 1.8rem; }
  .after-install h2 { margin: 0.35rem 0; }
  .after-install p:not(.eyebrow) { color: var(--sy-text-muted); }
  pre { overflow-x: auto; margin: 0; border-radius: 0.7rem; background: var(--brand-canvas); color: var(--brand-green); padding: 1rem; }
  @media (max-width: 780px) { .platform-layout, .after-install { grid-template-columns: 1fr; } }
</style>

---
import releaseManifest from '@/data/release-manifest.json'
import ContentPageLayout from '@/layouts/ContentPageLayout.astro'
import type { ReleaseManifest } from '@/lib/releases/types'

const manifest = releaseManifest as ReleaseManifest
const stable = manifest.channels.stable
const archives = stable?.assets.filter((asset) => asset.platform !== 'windows' && (asset.packageType === 'tar.gz' || asset.packageType === 'zip')) ?? []
---

<ContentPageLayout title="Headless and CLI installation" eyebrow="One Go binary" description="Run the local daemon, browser UI, and MCP tools without the desktop app on macOS or Linux. Windows and WSL2 support is coming soon.">
  <section class="panel cli-card">
    <div><p class="eyebrow">Stable archives</p><h2>{stable ? stable.tag : 'No stable release published'}</h2><p>{stable ? 'Published CLI archives include' : 'When published, CLI archives will include'} the Envarium binary, license, README, CLI contract, and compatibility policy. The binary serves the browser UI and MCP server without a JavaScript runtime.</p></div>
    {archives.length > 0 ? <ul>{archives.map((asset) => <li><a href={asset.downloadUrl}>{asset.name}</a><span>{asset.architecture} · {Math.round(asset.sizeBytes / 1024 / 1024)} MiB</span></li>)}</ul> : <div class="unavailable"><strong>No stable CLI archives are published yet.</strong><p>Build the binary from the repository using the commands below.</p></div>}
  </section>
  <section class="source-build"><div><p class="eyebrow">Build from source</p><h2 id="build-from-source">Build the CLI on macOS or Linux</h2><p>Install the Go and Node versions pinned in <a href="https://github.com/dcuellar322/envarium/blob/master/.go-version">.go-version</a> and <a href="https://github.com/dcuellar322/envarium/blob/master/.node-version">.node-version</a> and pnpm from package.json. Git and Make are also required. Rust is needed only for the desktop app. These commands produce an unsigned local binary. Ensure <code>~/.local/bin</code> is on your PATH.</p></div><pre><code>git clone https://github.com/dcuellar322/envarium.git
cd envarium
pnpm install --frozen-lockfile
make build
mkdir -p "$HOME/.local/bin"
install -m 0755 bin/envarium "$HOME/.local/bin/envarium"
envarium doctor</code></pre></section>
</ContentPageLayout>

<style>
  .cli-card { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 2rem; padding: 1.6rem; }
  h2 { margin: 0.35rem 0; }
  .cli-card p:not(.eyebrow), .source-build p { color: var(--sy-text-muted); }
  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--sy-border-subtle); padding: 0.65rem 0; }
  li a { color: var(--sy-accent-primary); overflow-wrap: anywhere; }
  li span { color: var(--sy-text-soft); font-family: var(--sy-font-mono); font-size: 0.72rem; }
  .unavailable { border: 1px dashed var(--sy-border-subtle); border-radius: 0.7rem; padding: 1.2rem; }
  .unavailable strong { color: var(--sy-status-warning); }
  .source-build { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 2rem; margin-top: 3rem; }
  pre { overflow-x: auto; margin: 0; border: 1px solid var(--sy-border-subtle); border-radius: var(--sy-radius-md); background: var(--brand-canvas); color: var(--brand-text); padding: 1.2rem; }
  @media (max-width: 720px) { .cli-card, .source-build { grid-template-columns: 1fr; } }
</style>

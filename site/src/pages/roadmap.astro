---
import ContentPageLayout from '@/layouts/ContentPageLayout.astro'
import releaseManifest from '@/data/release-manifest.json'
import type { ReleaseManifest } from '@/lib/releases/types'

const stable = (releaseManifest as ReleaseManifest).channels.stable
const lanes = [
  { status: 'Available today', tone: 'done', note: stable ? `Stable ${stable.tag} is published. Check downloads for platform packages, or build from source.` : 'Build on macOS or Linux today. Stable installers have not been published.', items: ['Review and approve discovered project commands', 'Start and stop Compose services and local processes', 'Inspect logs, health, ports, Git status, and resource usage', 'Run related projects and separate worktrees', 'Use project terminals and permissioned coding-agent tools'] },
  { status: 'Release priorities', tone: 'next', note: 'Upcoming distribution and platform support. No release date has been announced.', items: ['Signed macOS and Linux desktop installers', 'CLI archives with checksums, signatures, and SBOMs', 'Windows and WSL2 support — coming soon', 'Homebrew installation for a published stable release', 'Reliable installation, upgrades, and removal on supported systems'] },
]
---

<ContentPageLayout title="Roadmap" eyebrow="Project status" description="What you can use from source today and where release work is focused. Windows and WSL2 are coming soon; follow GitHub issues for progress.">
  <div class="roadmap">{lanes.map((lane) => <section class={`lane panel ${lane.tone}`}><div><span>{lane.status}</span><p>{lane.note}</p></div><ul>{lane.items.map((item) => <li>{item}</li>)}</ul></section>)}</div>
  <aside class="source panel"><div><strong>Follow development on GitHub.</strong><span>Report a problem or propose a feature through the community links. Check release notes for published packages.</span></div><a class="button" href="https://github.com/dcuellar322/envarium/issues">Browse issues</a><a class="button quiet" href="/community/">Propose a feature</a></aside>
</ContentPageLayout>

<style>
  .roadmap { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
  .lane { overflow: hidden; }
  .lane > div { min-height: 10rem; padding: 1.4rem; border-bottom: 1px solid var(--sy-border-subtle); }
  .lane > div > span { font-size: 1.1rem; font-weight: 800; }
  .lane.done > div > span { color: var(--sy-status-success); }
  .lane.next > div > span { color: var(--sy-accent-primary); }
  .lane p, .source span { color: var(--sy-text-muted); }
  .lane ul { display: grid; gap: 0.8rem; margin: 0; padding: 1.4rem 1.4rem 1.4rem 2.6rem; }
  .source { display: flex; align-items: center; gap: 0.7rem; margin-top: 2rem; padding: 1.2rem; }
  .source div { display: grid; margin-right: auto; }
  .source > a { flex-shrink: 0; }
  @media (max-width: 860px) { .roadmap { grid-template-columns: 1fr; } .lane > div { min-height: 0; } .source { align-items: stretch; flex-direction: column; } }
</style>

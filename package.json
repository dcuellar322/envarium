{
  "name": "envarium",
  "version": "1.0.0",
  "private": true,
  "description": "A local, project-oriented development command center",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "build": "pnpm --filter @envarium/web build",
    "desktop": "tauri",
    "desktop:prepare": "pnpm --dir web build && node desktop/scripts/build-sidecar.mjs",
    "desktop:dev": "cd desktop/src-tauri && pnpm -C ../.. exec tauri dev",
    "desktop:build": "cd desktop/src-tauri && pnpm -C ../.. exec tauri build --debug",
    "desktop:release": "cd desktop/src-tauri && pnpm -C ../.. exec tauri build --config tauri.release.conf.json --ci",
    "generate": "pnpm --filter @envarium/web generate",
    "format": "pnpm --filter @envarium/web format",
    "format:check": "pnpm --filter @envarium/web format:check",
    "lint": "pnpm --filter @envarium/web lint",
    "typecheck": "pnpm --filter @envarium/web typecheck",
    "test": "pnpm --filter @envarium/web test",
    "test:e2e": "pnpm --filter @envarium/web test:e2e",
    "test:visual": "pnpm --filter @envarium/web test:visual",
    "site:dev": "pnpm --filter @envarium/site dev",
    "site:generate": "pnpm --filter @envarium/site generate",
    "site:build": "pnpm --filter @envarium/site build",
    "site:check": "pnpm --filter @envarium/site check",
    "site:lint": "pnpm --filter @envarium/site lint",
    "site:test": "pnpm --filter @envarium/site test",
    "site:test:e2e": "pnpm --filter @envarium/site test:e2e",
    "site:test:visual": "pnpm --filter @envarium/site test:visual",
    "site:validate": "pnpm --filter @envarium/site validate"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "prettier": "3.9.6"
  }
}
